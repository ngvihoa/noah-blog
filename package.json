{
  "name": "viet-hoa-cardfolio",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/vite/bin/vite.js dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:contact": "node scripts/test-contact.mjs",
    "env:pull": "npx --yes vercel@65.16.0 env pull .env.local --environment=production --project=noah-blog --scope=ngvihoas-projects --yes",
    "cv:sync": "node scripts/sync-cv.mjs",
    "predev": "npm run cv:sync",
    "prebuild": "npm run cv:sync"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "1.168.60",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "nitro": "3.0.261103-rc",
    "nodemailer": "^10.6.0",
    "page-mascot": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.14"
  },
  "engines": {
    "node": "24.x"
  }
}
