{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "noah-blog-rouge.vercel.app" }],
      "destination": "https://www.noah.io.vn/:path*",
      "permanent": true
    }
  ]
}
